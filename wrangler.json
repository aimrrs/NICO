{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nico-pdt",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "out",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
